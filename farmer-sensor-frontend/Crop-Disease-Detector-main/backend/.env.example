# Copy to .env and fill in your values. Never commit real keys.

# Supabase Postgres + PostGIS.
# Project Settings > Database > Connection string (URI), then swap the
# postgresql:// scheme for postgresql+psycopg://.
# IMPORTANT: percent-encode special characters in the password
# (@ -> %40, # -> %23, / -> %2F, : -> %3A).
DATABASE_URL=postgresql+psycopg://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres

# Claude. REQUIRED for crop image analysis and the AI assistant.
# Without it, image analysis is disabled and the chatbot falls back to
# answering from the local agricultural knowledge base only.
ANTHROPIC_API_KEY=

# Any current Claude model; all of them support vision.
# e.g. claude-opus-5, claude-sonnet-5, claude-fable-5-1
# When using Azure AI Foundry this must match your DEPLOYMENT name.
ANTHROPIC_MODEL=claude-opus-5

# Optional: route through Azure AI Foundry instead of api.anthropic.com.
# Leave empty for the standard Anthropic API (keys look like sk-ant-...).
# Foundry example: https://<resource>.services.ai.azure.com/anthropic
ANTHROPIC_BASE_URL=

# Longest image edge (px) sent to Claude. Larger photos are downscaled first.
VISION_MAX_EDGE=1568

# Text-only AI Assistant chat (no file uploads), via an Azure OpenAI
# Responses API deployment.
ASSISTANT_API_KEY=
ASSISTANT_ENDPOINT=https://<resource>.services.ai.azure.com/openai/v1/responses

# Must match your Azure DEPLOYMENT name, not the base model name.
ASSISTANT_MODEL=gpt-5.4
ASSISTANT_MAX_TOKENS=900

# Which provider answers chat: "azure-openai" or "claude".
# Claude always handles crop image analysis regardless of this setting, and is
# used automatically if the chat assistant fails or has no key.
ASSISTANT_PROVIDER=azure-openai

# OpenWeatherMap. Without a key the dashboard shows demo weather.
OPENWEATHER_API_KEY=

# Default farm location (used when the browser does not share geolocation)
DEFAULT_LATITUDE=9.4981
DEFAULT_LONGITUDE=76.3388
DEFAULT_LOCATION_NAME=Alappuzha, Kerala

# Comma separated frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
