# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://startuperbyaries.services.ai.azure.com/openai/v1
AZURE_OPENAI_KEY=your_key_here
AZURE_OPENAI_MODEL=gpt-5.6-sol

# Weather (optional)
OPENWEATHER_API_KEY=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Speech recognition language: en-US or en-GB (avoid en-IN, it emits Hinglish)
SPEECH_LANGUAGE=en-US

# Azure gpt-4o-transcribe for speech to text (leave blank to use Twilio's)
STT_ENDPOINT=
STT_KEY=
USE_AZURE_STT=true

# Also text the answer to the farmer
SEND_SMS_ANSWER=true

# RAG docs folder
RAG_DOCS_PATH=./data/docs

# Base URL for Twilio webhooks (use ngrok URL in dev)
BASE_URL=http://localhost:8000
